APP_NAME=core-backend
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# Seeded on first startup if missing
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=changeme
BOOTSTRAP_NAME=Admin

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
JWT_EXPIRATION_SECONDS=86400

# Cursor SDK — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_WORKSPACE=/tmp/tin-yu-mal-cursor
CURSOR_WEB_TOOLS=true

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=tin-yu-mal
MINIO_SECURE=false
UPLOAD_MAX_BYTES=10485760
UPLOAD_CONTEXT_MAX_CHARS=12000

# Unsplash (optional — fills image.url; falls back to picsum without a key)
UNSPLASH_ACCESS_KEY=
